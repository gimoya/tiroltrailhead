        <actionsetting icon="" shortTitle="List feature ids" action="from qgis.PyQt import QtWidgets&#xa;&#xa;layer = QgsProject.instance().mapLayer('[% @layer_id %]')&#xa;if layer.selectedFeatureCount():&#xa;    ids = layer.selectedFeatureIds()&#xa;else:&#xa;    ids = [f.id() for f in layer.getFeatures()]&#xa;&#xa;QtWidgets.QMessageBox.information(None, &quot;Feature ids&quot;, ', '.join([str(id) for id in ids]))" notificationMessage="" id="{4c9cd883-d0ae-4ebd-9669-1b3d50a8ce98}" isEnabledOnlyWhenEditable="0" name="List feature ids" type="1" capture="0">
