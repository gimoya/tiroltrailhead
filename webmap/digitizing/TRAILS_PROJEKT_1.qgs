        <actionsetting notificationMessage="" isEnabledOnlyWhenEditable="0" capture="0" type="5" name="Open file" shortTitle="Open file" icon="" id="{30963672-ae0e-40b7-829f-c52a881a90a8}" action="[% &quot;PATH&quot; %]">
          <actionScope id="Canvas"/>
