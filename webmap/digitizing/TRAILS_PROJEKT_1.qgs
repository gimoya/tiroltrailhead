        <actionsetting type="5" action="[% &quot;PATH&quot; %]" shortTitle="Open file" capture="0" notificationMessage="" isEnabledOnlyWhenEditable="0" icon="" id="{30963672-ae0e-40b7-829f-c52a881a90a8}" name="Open file">
