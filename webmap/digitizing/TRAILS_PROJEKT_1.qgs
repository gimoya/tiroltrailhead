        <actionsetting notificationMessage="" isEnabledOnlyWhenEditable="0" capture="0" type="5" name="Search on web based on attribute's value" shortTitle="Search Web" icon="" id="{bc4be8bd-0b3d-480f-ad72-1b7332edeef5}" action="http://www.google.com/search?q=[% &quot;ATTRIBUTE&quot; %]">
          <actionScope id="Field"/>
