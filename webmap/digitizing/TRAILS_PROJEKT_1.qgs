        <default applyOnUpdate="0" field="Trail_Char" expression=""/>
        <default applyOnUpdate="1" field="Trail_Text" expression="concat(&#xd;&#xa;&#x9;'&lt;pre style=&quot;tab-size:3;&quot;>' ||&#xd;&#xa;&#x9;'Flow:&#x9;&#x9;&#x9;', Flow, '|', Flow_Killer ||&#xd;&#xa;&#x9;'&lt;br/>Tech:&#x9;&#x9;&#x9;', Tech ||&#xd;&#xa;&#x9;'&lt;br/>Gravity:&#x9;&#x9;', Gravity ||&#xd;&#xa;&#x9;'&lt;br/>Risk:&#x9;&#x9;&#x9;', Risk ||&#xd;&#xa;&#x9;if (length(Status) > 0, '&lt;br/>Status:&#x9;&#x9;' || Status, '') ||&#xd;&#xa;&#x9;'&lt;br/>&lt;br/>Länge:&#x9;&#x9;', round($length/1000,1), ' km' ||&#xd;&#xa;&#x9;'&lt;br/>Uphill:&#x9;&#x9;+', ele_gain, ' m' ||&#xd;&#xa;&#x9;'&lt;br/>Downhill:&#x9;', ele_loss, ' m' || '&lt;br/>' ||&#xd;&#xa;&#x9;if(length(Gem) > 0, '&lt;br/>Holy Trail:&#x9;' || Gem, '') ||&#xd;&#xa;&#x9;if(length(Wanderer)>0, '&lt;br/>Fussgeher:&#x9;' || Wanderer, '')&#x9;|| &#xd;&#xa;&#x9;if(length(Verbot)>0, '&lt;br/>Verbot:&#x9;&#x9;' || Verbot, '') ||&#xd;&#xa;&#x9;'&lt;/pre>'&#xd;&#xa;)"/>
        <default applyOnUpdate="1" field="Gem" expression="regexp_substr(&#xd;&#xa;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;regexp_replace( Trail_Char, 'LLL', '💎'),&#xd;&#xa;&#x9;&#x9;&#x9;'LL', ''),&#xd;&#xa;&#x9;&#x9;'L', ''),&#xd;&#xa;&#x9;'-', ''&#xd;&#xa;&#x9;),&#xd;&#xa;'💎')"/>
        <default applyOnUpdate="1" field="Gravity" expression="with_variable('my_string', &#xd;&#xa;&#x9;regexp_substr(&#xd;&#xa;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;regexp_replace( Trail_Char , 'GGG', '🚀🚀🚀'),&#xd;&#xa;&#x9;&#x9;&#x9;'GG', '🚀🚀O'),&#xd;&#xa;&#x9;&#x9;'G', '🚀OO'), &#xd;&#xa;&#x9;&#x9;'[🚀,O,?]+'&#xd;&#xa;&#x9;),&#xd;&#xa;&#x9;if(length(@my_string)=0, &#xd;&#xa;&#x9;&#x9;'OOO',&#xd;&#xa;&#x9;&#x9;@my_string&#xd;&#xa;&#x9;)&#xd;&#xa;)&#xd;&#xa;"/>
        <default applyOnUpdate="1" field="Risk" expression="with_variable('my_string', &#xd;&#xa;&#x9;regexp_substr(&#xd;&#xa;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;regexp_replace( Trail_Char, 'RRR', '💀💀💀'),&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;'RR', '💀💀O'),&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;'R', '💀OO'),&#xd;&#xa;&#x9;&#x9;&#x9;'[-,'']', 'OOO'), &#xd;&#xa;&#x9;&#x9;'[💀, O, ?]+'&#xd;&#xa;&#x9;),&#xd;&#xa;&#x9;if(length(@my_string)=0, &#xd;&#xa;&#x9;&#x9;'OOO',&#xd;&#xa;&#x9;&#x9;@my_string&#xd;&#xa;&#x9;)&#xd;&#xa;)&#x9;&#xd;&#xa;&#x9;"/>
        <default applyOnUpdate="1" field="Tech" expression="with_variable('my_string', &#xd;&#xa;&#x9;regexp_substr(&#xd;&#xa;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;regexp_replace( Trail_Char, 'TTT', '🔶🔶🔶'),&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;'TT', '🔶🔶O'),&#xd;&#xa;&#x9;&#x9;&#x9;'T', '🔶OO'), &#xd;&#xa;&#x9;&#x9;'[🔶,O,?]+'),&#xd;&#xa;&#x9;if(length(@my_string)=0, &#xd;&#xa;&#x9;&#x9;'OOO',&#xd;&#xa;&#x9;&#x9;@my_string&#xd;&#xa;&#x9;)&#xd;&#xa;)&#xd;&#xa;"/>
        <default applyOnUpdate="1" field="Flow_Killer" expression="with_variable('my_string', &#xd;&#xa;&#x9;regexp_substr(&#xd;&#xa;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;regexp_replace( Trail_Char, 'XXX', '👎👎👎'),&#xd;&#xa;&#x9;&#x9;&#x9;'XX', '👎👎O'),&#xd;&#xa;&#x9;&#x9;'X', '👎OO'), &#xd;&#xa;&#x9;&#x9;'[👎,O,?]+'&#xd;&#xa;&#x9;),&#xd;&#xa;&#x9;if(length(@my_string)=0, &#xd;&#xa;&#x9;&#x9;'OOO',&#xd;&#xa;&#x9;&#x9;@my_string&#xd;&#xa;&#x9;)&#xd;&#xa;)&#xd;&#xa;"/>
        <default applyOnUpdate="1" field="Wanderer" expression="with_variable('my_string', &#xd;&#xa;&#x9;regexp_substr(&#xd;&#xa;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;regexp_replace( Trail_Char, 'KKK', '👨‍👦👨‍👦👨‍👦'),&#xd;&#xa;&#x9;&#x9;&#x9;'KK', '👨‍👦👨‍👦'),&#xd;&#xa;&#x9;&#x9;&#x9;'K', '👨‍👦'), &#xd;&#xa;&#x9;&#x9;&#x9;'[👨‍👦,?]+'&#xd;&#xa;&#x9;),&#xd;&#xa;&#x9;if(length(@my_string)=0, &#xd;&#xa;&#x9;&#x9;'',&#xd;&#xa;&#x9;&#x9;@my_string&#xd;&#xa;&#x9;)&#xd;&#xa;)&#xd;&#xa;"/>
        <default applyOnUpdate="1" field="Verbot" expression="regexp_substr(&#xd;&#xa;&#x9;regexp_replace(  Trail_Char , 'K!', '🚳'),&#xd;&#xa;&#x9;'🚳'&#xd;&#xa;)"/>
        <default applyOnUpdate="1" field="Flow" expression="with_variable('my_string', &#xd;&#xa;&#x9;regexp_substr(&#xd;&#xa;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;regexp_replace( Trail_Char, 'FFF', '👍👍👍'),&#xd;&#xa;&#x9;&#x9;&#x9;'FF', '👍👍O'),&#xd;&#xa;&#x9;&#x9;'F', '👍OO'), &#xd;&#xa;&#x9;&#x9;'[👍,O,?]+'&#xd;&#xa;&#x9;),&#xd;&#xa;&#x9;if(length(@my_string)=0, &#xd;&#xa;&#x9;&#x9;'OOO',&#xd;&#xa;&#x9;&#x9;@my_string&#xd;&#xa;&#x9;)&#xd;&#xa;)&#xd;&#xa;"/>
        <default applyOnUpdate="1" field="Status" expression="with_variable('my_string', &#xd;&#xa;&#x9;regexp_substr(&#xd;&#xa;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;regexp_replace( Trail_Char, 'BBB', '❌❌❌'),&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;'BB', '❌❌O'),&#xd;&#xa;&#x9;&#x9;&#x9;'B', '❌OO'), &#xd;&#xa;&#x9;&#x9;'[❌,O,?]+'),&#xd;&#xa;&#x9;if(length(@my_string)=0, &#xd;&#xa;&#x9;&#x9;'OOO',&#xd;&#xa;&#x9;&#x9;@my_string&#xd;&#xa;&#x9;)&#xd;&#xa;)&#xd;&#xa;"/>
        <default applyOnUpdate="1" field="ele_gain" expression="with_variable('my_num',&#xd;&#xa;&#x9;array_sum(&#xd;&#xa;&#x9;&#x9;array_filter(&#xd;&#xa;&#x9;&#x9;&#x9;array_foreach(generate_series(1,num_geometries(nodes_to_points($geometry))-1),&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;z(geometry_n( nodes_to_points($geometry), @element+1)) - &#xd;&#xa;&#x9;&#x9;&#x9;&#x9;z(geometry_n( nodes_to_points($geometry), @element))&#xd;&#xa;&#x9;&#x9;&#x9;), @element>=0&#xd;&#xa;&#x9;&#x9;)&#xd;&#xa;&#x9;),&#xd;&#xa;&#x9;if(@my_num IS NULL, 0,&#xd;&#xa;&#x9;round(@my_num,0)&#xd;&#xa;&#x9;)&#xd;&#xa;)"/>
        <default applyOnUpdate="1" field="ele_loss" expression="with_variable('my_num',&#xd;&#xa;&#x9;array_sum(&#xd;&#xa;&#x9;&#x9;array_filter(&#xd;&#xa;&#x9;&#x9;&#x9;array_foreach(generate_series(1,num_geometries(nodes_to_points($geometry))-1),&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;z(geometry_n( nodes_to_points($geometry), @element+1)) - &#xd;&#xa;&#x9;&#x9;&#x9;&#x9;z(geometry_n( nodes_to_points($geometry), @element))&#xd;&#xa;&#x9;&#x9;&#x9;), @element&lt;=0&#xd;&#xa;&#x9;&#x9;)&#xd;&#xa;&#x9;),&#xd;&#xa;&#x9;if(@my_num IS NULL, 0,&#xd;&#xa;&#x9;round(@my_num,0)&#xd;&#xa;&#x9;)&#xd;&#xa;)"/>
        <default applyOnUpdate="0" field="ID" expression=""/>
