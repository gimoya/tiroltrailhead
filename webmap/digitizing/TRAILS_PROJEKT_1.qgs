        <actionsetting name="Clicked coordinates (Run feature actions tool)" icon="" type="1" notificationMessage="" action="from qgis.PyQt import QtWidgets&#xa;&#xa;QtWidgets.QMessageBox.information(None, &quot;Clicked coords&quot;, &quot;layer: [% @layer_id %]\ncoords: ([% @click_x %],[% @click_y %])&quot;)" capture="0" shortTitle="Clicked Coordinate" id="{bc6f9a87-a6a9-4c4b-8736-958f27194e7c}" isEnabledOnlyWhenEditable="0">
          <actionScope id="Canvas"/>
