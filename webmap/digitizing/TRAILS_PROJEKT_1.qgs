        <actionsetting name="Search on web based on attribute's value" icon="" type="5" notificationMessage="" action="http://www.google.com/search?q=[% &quot;ATTRIBUTE&quot; %]" capture="0" shortTitle="Search Web" id="{bc4be8bd-0b3d-480f-ad72-1b7332edeef5}" isEnabledOnlyWhenEditable="0">
          <actionScope id="Field"/>
