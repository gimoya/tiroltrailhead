        <actionsetting notificationMessage="" isEnabledOnlyWhenEditable="0" capture="0" type="1" name="List feature ids" shortTitle="List feature ids" icon="" id="{4c9cd883-d0ae-4ebd-9669-1b3d50a8ce98}" action="from qgis.PyQt import QtWidgets&#xa;&#xa;layer = QgsProject.instance().mapLayer('[% @layer_id %]')&#xa;if layer.selectedFeatureCount():&#xa;    ids = layer.selectedFeatureIds()&#xa;else:&#xa;    ids = [f.id() for f in layer.getFeatures()]&#xa;&#xa;QtWidgets.QMessageBox.information(None, &quot;Feature ids&quot;, ', '.join([str(id) for id in ids]))">
          <actionScope id="Layer"/>
        </actionsetting>
        <actionsetting notificationMessage="" isEnabledOnlyWhenEditable="1" capture="0" type="1" name="Duplicate selected features" shortTitle="Duplicate selected" icon="" id="{a3eb1dc5-a591-482a-836b-e0e71c79d37d}" action="project = QgsProject.instance()&#xa;layer = QgsProject.instance().mapLayer('[% @layer_id %]')&#xa;if not layer.isEditable():&#xa;    qgis.utils.iface.messageBar().pushMessage( 'Cannot duplicate feature in not editable mode on layer {layer}'.format( layer=layer.name() ) )&#xa;else:&#xa;    features=[]&#xa;    if len('[% $id %]')>0:&#xa;        features.append( layer.getFeature( [% $id %] ) )&#xa;    else:&#xa;        for x in layer.selectedFeatures():&#xa;            features.append( x )&#xa;    feature_count=0&#xa;    children_info=''&#xa;    featureids=[]&#xa;    for f in features:&#xa;        result=QgsVectorLayerUtils.duplicateFeature(layer, f, project, 0 )&#xa;        featureids.append( result[0].id() )&#xa;        feature_count+=1&#xa;        for ch_layer in result[1].layers():&#xa;            children_info+='{number_of_children} children on layer {children_layer}\n'.format( number_of_children=str( len( result[1].duplicatedFeatures(ch_layer) ) ), children_layer=ch_layer.name() )&#xa;            ch_layer.selectByIds( result[1].duplicatedFeatures(ch_layer) )&#xa;    layer.selectByIds( featureids )&#xa;    qgis.utils.iface.messageBar().pushMessage( '{number_of_features} features on layer {layer} duplicated with\n{children_info}'.format( number_of_features=str( feature_count ), layer=layer.name(), children_info=children_info ) )">
          <actionScope id="Layer"/>
        </actionsetting>
        <actionsetting notificationMessage="" isEnabledOnlyWhenEditable="0" capture="0" type="1" name="Select Features with Name" shortTitle="" icon="" id="{445702e7-9580-4ab1-b989-ea3f2d61613e}" action="layer_id = '[%@layer_id%]'&#xd;&#xa;layer = QgsProject().instance().mapLayer(layer_id)&#xd;&#xa;layer.selectByExpression('&quot;name&quot;=\'[% name %]\'')">
          <actionScope id="Canvas"/>
          <actionScope id="Feature"/>
        </actionsetting>
      </attributeactions>
