        <actionsetting icon="" isEnabledOnlyWhenEditable="0" notificationMessage="" id="{bc6f9a87-a6a9-4c4b-8736-958f27194e7c}" type="1" capture="0" name="Clicked coordinates (Run feature actions tool)" shortTitle="Clicked Coordinate" action="from qgis.PyQt import QtWidgets&#xa;&#xa;QtWidgets.QMessageBox.information(None, &quot;Clicked coords&quot;, &quot;layer: [% @layer_id %]\ncoords: ([% @click_x %],[% @click_y %])&quot;)">
          <actionScope id="Canvas"/>
