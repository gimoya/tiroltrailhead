        <actionsetting name="Open file" icon="" type="5" notificationMessage="" action="[% &quot;PATH&quot; %]" capture="0" shortTitle="Open file" id="{30963672-ae0e-40b7-829f-c52a881a90a8}" isEnabledOnlyWhenEditable="0">
