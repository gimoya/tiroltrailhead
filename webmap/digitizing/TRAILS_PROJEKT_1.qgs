      <defaults>
        <default expression="" field="fid" applyOnUpdate="0"/>
        <default expression="" field="name" applyOnUpdate="0"/>
        <default expression="" field="Trail_Char" applyOnUpdate="0"/>
        <default expression="concat(&#xd;&#xa;&#x9;'&lt;pre style=&quot;tab-size:3;&quot;>' ||&#xd;&#xa;&#x9;'Flow:&#x9;&#x9;&#x9;', Flow, '|', Flow_Killer ||&#xd;&#xa;&#x9;'&lt;br/>Tech:&#x9;&#x9;&#x9;', Tech ||&#xd;&#xa;&#x9;'&lt;br/>Features:&#x9;', Features ||&#xd;&#xa;&#x9;'&lt;br/>Exposure:&#x9;', Risk ||&#xd;&#xa;&#x9;if (length(Status) > 0, '&lt;br/>Status:&#x9;&#x9;' || Status, '') ||&#xd;&#xa;&#x9;'&lt;br/>&lt;br/>Länge:&#x9;&#x9;', round($length/1000,1), ' km' ||&#xd;&#xa;&#x9;'&lt;br/>Uphill:&#x9;&#x9;+', ele_gain, ' m' ||&#xd;&#xa;&#x9;'&lt;br/>Downhill:&#x9;', ele_loss, ' m' || '&lt;br/>' ||&#xd;&#xa;&#x9;if(length(Gem) > 0, '&lt;br/>Holy Trail:&#x9;' || Holy, '') ||&#xd;&#xa;&#x9;if(length(Wanderer)>0, '&lt;br/>Fussgeher:&#x9;' || Wanderer, '')&#x9;|| &#xd;&#xa;&#x9;if(length(Verbot)>0, '&lt;br/>Verbot:&#x9;&#x9;' || Verbot, '') ||&#xd;&#xa;&#x9;'&lt;/pre>'&#xd;&#xa;)" field="Trail_Text" applyOnUpdate="1"/>
        <default expression="" field="Holy" applyOnUpdate="0"/>
        <default expression="with_variable('my_string', &#xd;&#xa;&#x9;regexp_substr(&#xd;&#xa;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;regexp_replace( Trail_Char, 'GGG', '🔥🔥🔥'),&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;'GG', '🔥🔥O'),&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;'G', '🔥OO'),&#xd;&#xa;&#x9;&#x9;&#x9;'[-,'']', 'OOO'), &#xd;&#xa;&#x9;&#x9;'[🔥, O, ?]+'&#xd;&#xa;&#x9;),&#xd;&#xa;&#x9;if(length(@my_string)=0, &#xd;&#xa;&#x9;&#x9;'OOO',&#xd;&#xa;&#x9;&#x9;@my_string&#xd;&#xa;&#x9;)&#xd;&#xa;)&#xd;&#xa;&#x9;" field="Features" applyOnUpdate="1"/>
        <default expression="with_variable('my_string', &#xd;&#xa;&#x9;regexp_substr(&#xd;&#xa;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;regexp_replace( Trail_Char, 'RRR', '💀💀💀'),&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;'RR', '💀💀O'),&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;'R', '💀OO'),&#xd;&#xa;&#x9;&#x9;&#x9;'[-,'']', 'OOO'), &#xd;&#xa;&#x9;&#x9;'[💀, O, ?]+'&#xd;&#xa;&#x9;),&#xd;&#xa;&#x9;if(length(@my_string)=0, &#xd;&#xa;&#x9;&#x9;'OOO',&#xd;&#xa;&#x9;&#x9;@my_string&#xd;&#xa;&#x9;)&#xd;&#xa;)&#x9;&#xd;&#xa;&#x9;" field="Risk" applyOnUpdate="1"/>
        <default expression="with_variable('my_string', &#xd;&#xa;&#x9;regexp_substr(&#xd;&#xa;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;regexp_replace( Trail_Char, 'TTT', '🔶🔶🔶'),&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;'TT', '🔶🔶O'),&#xd;&#xa;&#x9;&#x9;&#x9;'T', '🔶OO'), &#xd;&#xa;&#x9;&#x9;'[🔶,O,?]+'),&#xd;&#xa;&#x9;if(length(@my_string)=0, &#xd;&#xa;&#x9;&#x9;'OOO',&#xd;&#xa;&#x9;&#x9;@my_string&#xd;&#xa;&#x9;)&#xd;&#xa;)&#xd;&#xa;" field="Tech" applyOnUpdate="1"/>
        <default expression="with_variable('my_string', &#xd;&#xa;&#x9;regexp_substr(&#xd;&#xa;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;regexp_replace( Trail_Char, 'KKK', '👎👎👎'),&#xd;&#xa;&#x9;&#x9;&#x9;'KK', '👎👎O'),&#xd;&#xa;&#x9;&#x9;'K', '👎OO'), &#xd;&#xa;&#x9;&#x9;'[👎,O,?]+'&#xd;&#xa;&#x9;),&#xd;&#xa;&#x9;if(length(@my_string)=0, &#xd;&#xa;&#x9;&#x9;'OOO',&#xd;&#xa;&#x9;&#x9;@my_string&#xd;&#xa;&#x9;)&#xd;&#xa;)&#xd;&#xa;" field="Flow_Killer" applyOnUpdate="1"/>
        <default expression="with_variable('my_string', &#xd;&#xa;&#x9;regexp_substr(&#xd;&#xa;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;regexp_replace( Trail_Char, 'WWW', '👨‍👦👨‍👦👨‍👦'),&#xd;&#xa;&#x9;&#x9;&#x9;'WW', '👨‍👦👨‍👦'),&#xd;&#xa;&#x9;&#x9;&#x9;'W', '👨‍👦'), &#xd;&#xa;&#x9;&#x9;&#x9;'[👨‍👦,?]+'&#xd;&#xa;&#x9;),&#xd;&#xa;&#x9;if(length(@my_string)=0, &#xd;&#xa;&#x9;&#x9;'',&#xd;&#xa;&#x9;&#x9;@my_string&#xd;&#xa;&#x9;)&#xd;&#xa;)&#xd;&#xa;" field="Wanderer" applyOnUpdate="1"/>
        <default expression="regexp_substr(&#xd;&#xa;&#x9;regexp_replace(  Trail_Char , '!', '🚳'),&#xd;&#xa;&#x9;'🚳'&#xd;&#xa;)" field="Verbot" applyOnUpdate="1"/>
        <default expression="with_variable('my_string', &#xd;&#xa;&#x9;regexp_substr(&#xd;&#xa;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;regexp_replace( Trail_Char, 'FFF', '👍👍👍'),&#xd;&#xa;&#x9;&#x9;&#x9;'FF', '👍👍O'),&#xd;&#xa;&#x9;&#x9;'F', '👍OO'), &#xd;&#xa;&#x9;&#x9;'[👍,O,?]+'&#xd;&#xa;&#x9;),&#xd;&#xa;&#x9;if(length(@my_string)=0, &#xd;&#xa;&#x9;&#x9;'OOO',&#xd;&#xa;&#x9;&#x9;@my_string&#xd;&#xa;&#x9;)&#xd;&#xa;)&#xd;&#xa;" field="Flow" applyOnUpdate="1"/>
        <default expression="with_variable('my_string', &#xd;&#xa;&#x9;regexp_substr(&#xd;&#xa;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;regexp_replace( Trail_Char, 'XXX', '❌❌❌'),&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;'XX', '❌❌O'),&#xd;&#xa;&#x9;&#x9;&#x9;'X', '❌OO'), &#xd;&#xa;&#x9;&#x9;'[❌,O,?]+'),&#xd;&#xa;&#x9;if(length(@my_string)=0, &#xd;&#xa;&#x9;&#x9;'OOO',&#xd;&#xa;&#x9;&#x9;@my_string&#xd;&#xa;&#x9;)&#xd;&#xa;)&#xd;&#xa;" field="Status" applyOnUpdate="1"/>
        <default expression="with_variable('my_num',&#xd;&#xa;&#x9;array_sum(&#xd;&#xa;&#x9;&#x9;array_filter(&#xd;&#xa;&#x9;&#x9;&#x9;array_foreach(generate_series(1,num_geometries(nodes_to_points($geometry))-1),&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;z(geometry_n( nodes_to_points($geometry), @element+1)) - &#xd;&#xa;&#x9;&#x9;&#x9;&#x9;z(geometry_n( nodes_to_points($geometry), @element))&#xd;&#xa;&#x9;&#x9;&#x9;), @element>=0&#xd;&#xa;&#x9;&#x9;)&#xd;&#xa;&#x9;),&#xd;&#xa;&#x9;if(@my_num IS NULL, 0,&#xd;&#xa;&#x9;round(@my_num,0)&#xd;&#xa;&#x9;)&#xd;&#xa;)" field="ele_gain" applyOnUpdate="1"/>
        <default expression="with_variable('my_num',&#xd;&#xa;&#x9;array_sum(&#xd;&#xa;&#x9;&#x9;array_filter(&#xd;&#xa;&#x9;&#x9;&#x9;array_foreach(generate_series(1,num_geometries(nodes_to_points($geometry))-1),&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;z(geometry_n( nodes_to_points($geometry), @element+1)) - &#xd;&#xa;&#x9;&#x9;&#x9;&#x9;z(geometry_n( nodes_to_points($geometry), @element))&#xd;&#xa;&#x9;&#x9;&#x9;), @element&lt;=0&#xd;&#xa;&#x9;&#x9;)&#xd;&#xa;&#x9;),&#xd;&#xa;&#x9;if(@my_num IS NULL, 0,&#xd;&#xa;&#x9;round(@my_num,0)&#xd;&#xa;&#x9;)&#xd;&#xa;)" field="ele_loss" applyOnUpdate="1"/>
        <default expression="with_variable('my_string', &#xd;&#xa;&#x9;regexp_substr(&#xd;&#xa;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;regexp_replace(&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;regexp_replace( Trail_Char , 'GGG', '🚀🚀🚀'),&#xd;&#xa;&#x9;&#x9;&#x9;'GG', '🚀🚀O'),&#xd;&#xa;&#x9;&#x9;'G', '🚀OO'), &#xd;&#xa;&#x9;&#x9;'[🚀,O,?]+'&#xd;&#xa;&#x9;),&#xd;&#xa;&#x9;if(length(@my_string)=0, &#xd;&#xa;&#x9;&#x9;'OOO',&#xd;&#xa;&#x9;&#x9;@my_string&#xd;&#xa;&#x9;)&#xd;&#xa;)&#xd;&#xa;" field="ID" applyOnUpdate="1"/>
      </defaults>
